#!/bin/bash
#SBATCH --job-name=scvidr_seeds
#SBATCH --partition=general-short,general-long-gpu
#SBATCH --gpus=1
#SBATCH --time=02:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64G
#SBATCH --array=0-29
#SBATCH --output=/mnt/scratch/bowmand8/taPVAT_scVIDR/code/scVIDR/hpcc/logs/%x-%A_%a.out

# 30 array tasks = 6 age/sex strata x 5 seeds (0-4). Each task trains+predicts
# every cell type in one stratum at one seed. Outputs go under
# results/<age>/<sex>/<cell_type>/seed<N>/. Inputs are reused (prepared earlier).
set -euo pipefail
ROOT=/mnt/scratch/bowmand8/taPVAT_scVIDR
cd "$ROOT"

module purge
module load Miniforge3
source "${EBROOTMINIFORGE3}/etc/profile.d/conda.sh"
conda activate "$ROOT/envs/scVIDR_env"

STRATA_AGE=(8W 8W   8W   24W 24W  24W)
STRATA_SEX=(M  F    Both M   F    Both)
i=${SLURM_ARRAY_TASK_ID}
s=$(( i / 5 ))
SEED=$(( i % 5 ))
AGE=${STRATA_AGE[$s]}
SEX=${STRATA_SEX[$s]}

echo "host=$(hostname)  stratum=${AGE}_${SEX}  seed=${SEED}  task=${i}  CUDA=${CUDA_VISIBLE_DEVICES:-none}  start=$(date)"
python -c "import torch; print('cuda_available=', torch.cuda.is_available(), torch.cuda.get_device_name(0) if torch.cuda.is_available() else '')"
python code/scVIDR/scripts/run_tapvat_scvidr.py run --age "$AGE" --sex "$SEX" --seed "$SEED" --skip-gene-scores
echo "stratum ${AGE}_${SEX} seed ${SEED} done  end=$(date)"
