#!/bin/bash
#SBATCH --job-name=scvidr_prep
#SBATCH --partition=general-long
#SBATCH --time=00:30:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=24G
#SBATCH --output=/mnt/scratch/bowmand8/taPVAT_scVIDR/code/scVIDR/hpcc/logs/%x-%j.out

# Builds the six stratum input h5ads (8W/24W x M/F/Both) from the full dataset.
# Loads the 4.6 GB source once, so this is a CPU job with generous memory.
set -euo pipefail
ROOT=/mnt/scratch/bowmand8/taPVAT_scVIDR
cd "$ROOT"

module purge
module load Miniforge3
source "${EBROOTMINIFORGE3}/etc/profile.d/conda.sh"
conda activate "$ROOT/envs/scVIDR_env"

echo "host=$(hostname)  start=$(date)"
python code/scVIDR/scripts/run_tapvat_scvidr.py prepare-inputs
echo "prepare-inputs done  end=$(date)"
